{
  "name": "dsh-host-mcp",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin: connect to host_server_mcp instances (本机文件 + 脚本执行 MCP 服务) — configure servers in the Web settings page, then inspect, run scripts and troubleshoot them from the agent or the browser panel.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit",
    "check:plugin": "npm run build && node scripts/check-plugin.mjs",
    "check:resolve": "node scripts/check-resolve.mjs",
    "check:cordis": "node scripts/check-cordis-get.mjs",
    "check:parse": "node scripts/check-parse.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check": "npm run check:plugin && npm run check:resolve && npm run check:cordis && npm run check:parse",
    "test": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "host-server-mcp",
    "mcp",
    "ops",
    "troubleshooting"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
